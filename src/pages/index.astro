---
import '../styles/layout-primitives.css';
import '../styles/scheme-default.css';
import '../styles/elements.css';
import { Button, Card, Footer, Header, Nav, NavItem, Section, Modal } from '../index';
import heroImage from '../assets/image.jpg?url';

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>koan playground</title>
  </head>
  <body>
    <main id="top" class="main jump-links">
      <Section
        scheme="dark"
      >
        <Header variant="overlay" measure="100%">
          <Nav>
            <NavItem uri="https://sleepingmonk.github.io/koan/" label="Documentation" external={true}/>
            <NavItem uri="https://bionic.studio" label="Bionic Studio" external={true}/>
            <NavItem uri="#jump" label="Jump" />
            <NavItem uri="#" label="#home" />
          </Nav>
        </Header>
      </Section>

      <Section
        heading="Koan for Astro"
        level="1"
        bgImage={heroImage}
        scheme="accent"
      >
        <div class="center" style="display: flex; justify-content: center; align-items: center;">
          <Card
            variant="bordered-center"
          >
            <p>To use Koan in your astro project:</p>
            <p><code>npm install koan-astro</code></p>
          </Card>
        </div>
      </Section>
      <Section
        brow="Brow"
        heading="Heading"
        level="2"
        scheme=""
      >
        <Modal
          variant="default"
        >
          <span slot='trigger'>
            Open Modal
          </span>
          <Section
            scheme="dark"
          >
            <p>This is a modal with dark color scheme.</p>
          </Section>
        </Modal>
        <Modal
          variant="bar"
        >
          <span slot='trigger'>
            Open Modal With Bar
          </span>
          <Section
            scheme="accent"
          >
            <p>This is a modal with a bar and accent color scheme.</p>
          </Section>
        </Modal>
        <a href="#jump">Jump to Jump Links</a>
        <div class="container stack">
          <h2>Buttons</h2>
          <div class="cluster">
            <Button
              label="Default Large"
              href="#"
              type="default"
              size="large"
              external={false}
            />
            <Button
              label="Primary Large"
              href="#"
              type="primary"
              size="large"
              external={false}
            />
            <Button
              label="Secondary Large"
              href="#"
              type="secondary"
              size="large"
              external={false}
            />
            <Button
              label="Text Large"
              href="#"
              type="text"
              size="large"
              external={false}
            />
          </div>
          <div class="cluster">
            <Button
              label="Default"
              href="#"
              type="default"
              size="default"
              external={false}
            />
            <Button
              label="Primary"
              href="#"
              type="primary"
              size="default"
              external={false}
            />
            <Button
              label="Secondary"
              href="#"
              type="secondary"
              size="default"
              external={false}
            />
            <Button
              label="Text"
              href="#"
              type="text"
              size="default"
              external={false}
            />
          </div>
          <div class="cluster">
            <Button
              label="Default Small"
              href="#"
              type="default"
              size="small"
              external={false}
            />
            <Button
              label="Primary Small"
              href="#"
              type="primary"
              size="small"
              external={false}
            />
            <Button
              label="Secondary Small"
              href="#"
              type="secondary"
              size="small"
              external={false}
            />
            <Button
              label="Text Small"
              href="#"
              type="text"
              size="small"
              external={false}
            />
          </div>
        </div>
        <div class="container stack">
          <h2>Cards</h2>
          <div class="grid" style="--grid-min-width: 25ch;">
            <Card
              scheme="inherit"
              heading="inherit"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <p>This card inherits its color scheme.</p>
            </Card>
            <Card
              scheme="dark"
              heading="dark"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <p>This is a card in a dark scheme.</p>
            </Card>
            <Card
              scheme="light"
              heading="light"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <p>This is a card in a light scheme.</p>
            </Card>
            <Card
              scheme="base"
              heading="base"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <p>This is a card in a base scheme.</p>
            </Card>
            <Card
              scheme="primary"
              heading="primary"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <p>This is a card in a primary scheme.</p>
            </Card>
            <Card
              scheme="accent"
              heading="accent"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <p>This is a card in a accent scheme.</p>
            </Card>
            <Card
              variant="media"
              heading="Media"
            >
              <img src={heroImage} alt="Example image" slot="media" />
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec auctor, nisl eget ultricies lacinia, nunc nisl aliquam nisl, eget aliquam nunc nisl eget nunc.</p>
            </Card>
            <Card
              variant="overlay"
              heading="Overlay"
              bgImage={heroImage}
            >
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec auctor, nisl eget ultricies lacinia, nunc nisl aliquam nisl, eget aliquam nunc nisl eget nunc.</p>
            </Card>
            <Card
              variant="bordered"
              heading="Bordered"
            >
              <img src={heroImage} alt="Example image" slot="media" />
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec auctor, nisl eget ultricies lacinia, nunc nisl aliquam nisl, eget aliquam nunc nisl eget nunc.</p>
            </Card>
            <Card
              variant="bordered-center"
              heading="Bordered Center"
            >
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec auctor, nisl eget ultricies lacinia, nunc nisl aliquam nisl, eget aliquam nunc nisl eget nunc.</p>
            </Card>
          </div>
          <div class="">
            <Card
              variant="media-right"
              heading="Media Right"
              buttonHref="#"
              buttonLabel="Click Me"
            >
              <img src={heroImage} alt="Example image" slot="media" />
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec auctor, nisl eget ultricies lacinia, nunc nisl aliquam nisl, eget aliquam nunc nisl eget nunc.</p>
            </Card>
            <Card
              variant="media-left"
              heading="Media Left"
            >
              <img src={heroImage} alt="Example image" slot="media" />
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec auctor, nisl eget ultricies lacinia, nunc nisl aliquam nisl, eget aliquam nunc nisl eget nunc.</p>
            </Card>
          </div>
        </div>
      </Section>
      <Section
        id="jump"
        heading="Jump Links"
        level="2"
        scheme="primary"
      >
        <div class="center stack">
          <p>Jump Links jump to different sections of the page.</p>
          <p>Add a <code>jump-links</code> class to any element that contains one or more <code>{`<a></a>`}</code> elements you want to make jump links. The <code>a</code> elements should have <code>href</code> attributes pointing to the target sections using <code>#id</code>.</p>
          <p>Add the following script to initialize the jump links:</p>
          <pre><code>{`<script>
  import { initJumpLinks } from 'koan-astro';
  initJumpLinks();
</script>`}</code></pre>
          <NavItem uri="#top" label="Top" />
        </div>
      </Section>
      <Footer />
    </main>
  </body>
  <script>
    import { initJumpLinks } from 'koan-astro';
    initJumpLinks();
  </script>
</html>
