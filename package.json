{
  "name": "koan-astro",
  "version": "1.0.4",
  "description": "Composable Astro component templates.",
  "type": "module",
  "files": [
    "src/index.ts",
    "src/js",
    "src/components",
    "src/assets",
    "src/styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./Button": "./src/components/Atoms/Button/Button.astro",
    "./Brow": "./src/components/Atoms/Brow/Brow.astro",
    "./Logo": "./src/components/Atoms/Logo/Logo.astro",
    "./NavItem": "./src/components/Atoms/NavItem/NavItem.astro",
    "./Card": "./src/components/Molecules/Card/Card.astro",
    "./DropCluster": "./src/components/Molecules/DropCluster/DropCluster.astro",
    "./Modal": "./src/components/Molecules/Modal/Modal.astro",
    "./Nav": "./src/components/Molecules/Nav/Nav.astro",
    "./Cards": "./src/components/Organisms/Cards/Cards.astro",
    "./Footer": "./src/components/Organisms/Footer/Footer.astro",
    "./Header": "./src/components/Organisms/Header/Header.astro",
    "./Section": "./src/components/Organisms/Section/Section.astro",
    "./js/*": "./src/js/*",
    "./components/*": "./src/components/*",
    "./assets/icons.svg": "./src/assets/icons.svg",
    "./styles/*": "./src/styles/*",
    "./styles/layout-primitives.css": "./src/styles/layout-primitives.css",
    "./styles/scheme-default.css": "./src/styles/scheme-default.css",
    "./styles/animations.css": "./src/styles/animations.css",
    "./styles/build-in.css": "./src/styles/build-in.css",
    "./styles/elements.css": "./src/styles/elements.css",
    "./styles/lighting.css": "./src/styles/lighting.css"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "histlog": "sh ./scripts/histlog.sh",
    "prepack": "npm run check && npm run build",
    "preversion": "npm run check && npm run build",
    "version": "npm run histlog && git add History.md",
    "postversion": "if [ \"$SKIP_PUBLISH\" = \"1\" ]; then echo 'Skipping publish/push (SKIP_PUBLISH=1)'; else npm publish && git push --follow-tags; fi",
    "release:test": "SKIP_PUBLISH=1 npm version prerelease --preid=rc",
    "dry": "npm pack --dry-run && echo 'Dry run complete. No files were actually packed.' && echo 'If everything looks good:' && echo '  npm version [major|minor|patch]' && echo '  ***** MAKE SURE YOU ARE LOGGED IN WITH npm login | Current User: ' && npm whoami"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "astro": "^6.4.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9"
  }
}
