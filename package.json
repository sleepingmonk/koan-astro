{
  "name": "koan-astro",
  "version": "1.0.1",
  "description": "Reusable Astro component templates.",
  "type": "module",
  "files": [
    "src/index.ts",
    "src/js",
    "src/components",
    "src/assets",
    "src/styles",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./js/*": "./src/js/*",
    "./components/*": "./src/components/*",
    "./assets/icons.svg": "./src/assets/icons.svg",
    "./styles/*": "./src/styles/*",
    "./styles/layout-primitives.css": "./src/styles/layout-primitives.css",
    "./styles/scheme-default.css": "./src/styles/scheme-default.css",
    "./styles/animations.css": "./src/styles/animations.css",
    "./styles/build-in.css": "./src/styles/build-in.css",
    "./styles/elements.css": "./src/styles/elements.css",
    "./styles/lighting.css": "./src/styles/lighting.css"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "histlog": "sh ./scripts/histlog.sh",
    "prepack": "npm run check && npm run build",
    "preversion": "npm run check && npm run build",
    "version": "npm run histlog && git add History.md",
    "postversion": "if [ \"$SKIP_PUBLISH\" = \"1\" ]; then echo 'Skipping publish/push (SKIP_PUBLISH=1)'; else npm publish && git push --follow-tags; fi",
    "release:test": "SKIP_PUBLISH=1 npm version prerelease --preid=rc",
    "dry": "npm pack --dry-run && echo 'Dry run complete. No files were actually packed.' && echo 'If everything looks good:' && echo '  npm version [major|minor|patch]'"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "astro": "^6.4.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9"
  }
}
